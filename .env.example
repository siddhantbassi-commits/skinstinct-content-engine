# Telegram — from @BotFather after you create your bot
TELEGRAM_BOT_TOKEN=your_token_here

# Google AI Studio — used for scoring + keyword extraction (Gemini Flash), and for
# drafting when DRAFT_MODEL=gemini
GEMINI_API_KEY=your_gemini_key_here

# Anthropic — used for drafting when DRAFT_MODEL=claude (the default from B1 onward)
ANTHROPIC_API_KEY=your_anthropic_key_here

# Supabase project settings (Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# "claude" or "gemini" — which model writes the draft. Case brief: Gemini for the L3
# demo, Claude from B1 onward because it holds voice better across a full post.
DRAFT_MODEL=claude

# Minimum score (0-10) a note must clear before a draft is generated
SCORE_THRESHOLD=6
