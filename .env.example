# Telegram — from @BotFather after you create your bot
TELEGRAM_BOT_TOKEN=your_token_here

# Google AI Studio — used for everything: scoring + keyword extraction (Gemini
# Flash) and drafting (Gemini Pro). No Anthropic key is used in this project.
GEMINI_API_KEY=your_gemini_key_here

# Supabase project settings (Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Minimum score (0-10) a note must clear before a draft is generated
SCORE_THRESHOLD=6
